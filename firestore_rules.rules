rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: each user document is private to that user.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      // allow updates/deletes by the owner or by admins (custom claim `admin`)
      allow update, delete: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
    }

    // Devices collection: device documents reference an `owner` (uid)
    match /devices/{deviceId} {
      // read allowed to owner or admins
      allow read: if request.auth != null && (request.auth.uid == resource.data.owner || request.auth.token.admin == true);

      // create allowed when the authenticated user is the owner in the incoming data
      // or when a trusted service token is creating the device on behalf of an owner.
      allow create: if request.auth != null
        && request.resource.data.owner is string
        && (
          request.resource.data.owner == request.auth.uid
          || request.auth.token.service == true
        );

      // update allowed for owner or admin
      allow update: if request.auth != null && (request.auth.uid == resource.data.owner || request.auth.token.admin == true || request.auth.token.service == true);
      allow delete: if request.auth != null && (request.auth.uid == resource.data.owner || request.auth.token.admin == true);

      // Subcollection: logs for each device
      match /logs/{logId} {
        // device agents (service accounts / custom claim `service:true`) or the owner may write logs
        allow write: if request.auth != null && (
          request.auth.token.service == true
          || request.auth.uid == request.resource.data.owner
          || request.auth.uid == resource.data.owner
        );
        allow read: if request.auth != null && (request.auth.uid == resource.data.owner || request.auth.token.admin == true);
      }
    }

    // Fallback: deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
